{
  "name": "indico-saucedemo-ui-tests",
  "version": "1.0.0",
  "private": true,
  "description": "UI automation tests for saucedemo.com: login and checkout of Sauce Labs Onesie",
  "scripts": {
    "test": "playwright test",
